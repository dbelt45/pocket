# Pocket secrets. NEVER commit this file. Paste the whole thing into
# Vercel -> Settings -> Environment Variables (it accepts a pasted .env).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Supabase -> Settings -> API Keys -> Secret keys. Server only, used by the morning reminder.
SUPABASE_SECRET_KEY=
OPENROUTER_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
CRON_SECRET=
# Jarvis's voice. Leave blank and Jarvis uses the phone's built-in voice.
# ElevenLabs -> Developers -> API Keys (only "Text to Speech" access is needed).
ELEVENLABS_API_KEY=
# ElevenLabs -> Voices -> the voice's "..." menu -> Copy voice ID.
ELEVENLABS_VOICE_ID=
